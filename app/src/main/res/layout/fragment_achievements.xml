<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical"
    tools:context=".AchievementsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/achievements_titol"
            android:textAppearance="@style/TextAppearance.Player1.Headline"
            android:textColor="@color/ice_white"
            tools:targetApi="28" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/achievements_subtitol"
            android:textAppearance="@style/TextAppearance.Player1.BodySecondary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            app:cardBackgroundColor="@color/slate_blue"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/slate_blue_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/achievements_progreso_general"
                    android:textColor="@color/ice_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/achievements_progreso_descripcion"
                        android:textColor="@color/grey_blue"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/achievements_progreso_porcentaje"
                        android:textColor="@color/gold"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:max="100"
                    android:progress="35"
                    android:progressTint="@color/gold"
                    android:progressBackgroundTint="@color/slate_blue_stroke" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:accessibilityHeading="true"
            android:text="@string/achievements_ramas"
            android:textAppearance="@style/TextAppearance.Player1.SectionLabel"
            tools:targetApi="28" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gladiador"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:gravity="center"
                android:singleLine="false"
                android:text="@string/achievements_gladiador" />

            <Space
                android:layout_width="@dimen/spacing_s"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_erudito"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:gravity="center"
                android:singleLine="false"
                android:text="@string/achievements_erudito" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_artesano"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:gravity="center"
                android:singleLine="false"
                android:text="@string/achievements_artesano" />

            <Space
                android:layout_width="@dimen/spacing_s"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_explorador"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:gravity="center"
                android:singleLine="false"
                android:text="@string/achievements_explorador" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guardian"
            style="@style/Widget.Player1.Button.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_gravity="center"
            android:maxWidth="320dp"
            android:minWidth="0dp"
            android:gravity="center"
            android:singleLine="false"
            android:text="@string/achievements_guardian" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>