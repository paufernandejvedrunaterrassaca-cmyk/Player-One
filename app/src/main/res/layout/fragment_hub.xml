
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".HubFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/logo_small"
                android:layout_height="@dimen/logo_small"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:letterSpacing="0.08"
                    android:text="@string/nom_marca"
                    android:textAppearance="@style/TextAppearance.Player1.Headline"
                    android:textColor="@color/gold"
                    tools:targetApi="28" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/centre_control_subtitol"
                    android:textAppearance="@style/TextAppearance.Player1.BodySecondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:text="@string/seccio_acces"
            android:textAppearance="@style/TextAppearance.Player1.SectionLabel"
            tools:targetApi="28" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_welcome"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_benvinguda"
                app:icon="@drawable/ic_flag" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_inici_sessio"
                app:icon="@drawable/ic_login" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_register"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_registre"
                app:icon="@drawable/ic_person_add" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:text="@string/seccio_missions"
            android:textAppearance="@style/TextAppearance.Player1.SectionLabel"
            tools:targetApi="28" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mission_list"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_llista_missions"
                app:icon="@drawable/ic_list" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mission_detail"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_detall_missio"
                app:icon="@drawable/ic_visibility" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:text="@string/seccio_assoliments_social"
            android:textAppearance="@style/TextAppearance.Player1.SectionLabel"
            tools:targetApi="28" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_achievements"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_assoliments"
                app:icon="@drawable/ic_cup" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_groups"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_grups"
                app:icon="@drawable/ic_groups" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_group_chat"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:gravity="center"
                android:singleLine="false"
                android:text="@string/pantalla_xat_grup"
                app:icon="@drawable/ic_chat" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_group_detail"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:gravity="center"
                android:singleLine="false"
                android:text="@string/pantalla_detall_grup"
                app:icon="@drawable/ic_groups" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_m"
            android:text="@string/seccio_especialitzacions"
            android:textAppearance="@style/TextAppearance.Player1.SectionLabel"
            android:accessibilityHeading="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="5">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gladiador"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="80dp"
                android:padding="4dp"
                android:text="@string/achievements_gladiador"
                android:textSize="10sp"
                app:icon="@drawable/ic_cup"
                app:iconGravity="textTop"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_erudito"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="80dp"
                android:padding="4dp"
                android:text="@string/achievements_erudito"
                android:textSize="10sp"
                app:icon="@drawable/ic_list"
                app:iconGravity="textTop"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_artesano"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="80dp"
                android:padding="4dp"
                android:text="@string/achievements_artesano"
                android:textSize="10sp"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textTop"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_explorador"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="80dp"
                android:padding="4dp"
                android:text="@string/achievements_explorador"
                android:textSize="10sp"
                app:icon="@drawable/ic_flag"
                app:iconGravity="textTop"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guardian"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="80dp"
                android:padding="4dp"
                android:text="@string/achievements_guardian"
                android:textSize="10sp"
                app:icon="@drawable/ic_visibility"
                app:iconGravity="textTop"
                app:iconSize="24dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:text="@string/seccio_creacio"
            android:textAppearance="@style/TextAppearance.Player1.SectionLabel"
            tools:targetApi="28" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_my_missions"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_meves_missions"
                app:icon="@drawable/ic_add_circle" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_mission"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_editar_missio"
                app:icon="@drawable/ic_edit" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:text="@string/seccio_perfil"
            android:textAppearance="@style/TextAppearance.Player1.SectionLabel"
            tools:targetApi="28" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_perfil"
                app:icon="@drawable/ic_person" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_preferencies"
                app:icon="@drawable/ic_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_help"
                style="@style/Widget.Player1.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxWidth="320dp"
                android:gravity="center"
                android:singleLine="false"
                android:ellipsize="none"
                android:text="@string/pantalla_ajuda"
                app:icon="@drawable/ic_help" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
